# SearchJet API Configuration
SEARCHJET_API_KEY=your_api_key_here
SEARCHJET_BASE_URL=https://api.searchjetengine.com
SEARCHJET_SITE_ID=your_site_id_here

# SearchJet Auto-Sync
SEARCHJET_AUTO_SYNC=true
SEARCHJET_SYNC_ERRORS_THROW=false

# SearchJet Analytics
SEARCHJET_ANALYTICS_ENABLED=true
SEARCHJET_TRACK_QUERIES=true
SEARCHJET_TRACK_CLICKS=true
SEARCHJET_TRACK_ZERO_RESULTS=true

# SearchJet Caching
SEARCHJET_CACHE_ENABLED=true
SEARCHJET_CACHE_TTL=300

# SearchJet Rate Limiting
SEARCHJET_RATE_LIMITING_ENABLED=true
SEARCHJET_MAX_REQUESTS_PER_MINUTE=100

# SearchJet Events
SEARCHJET_EVENTS_ENABLED=true

# SearchJet HTTP Client
SEARCHJET_HTTP_TIMEOUT=30
SEARCHJET_HTTP_RETRY_ATTEMPTS=3
SEARCHJET_HTTP_RETRY_DELAY=1000
