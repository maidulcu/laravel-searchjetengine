{
    "name": "searchjet/laravel-searchjet",
    "description": "Laravel client for the SearchJet search API: search, document indexing and search analytics",
    "keywords": [
        "laravel",
        "search",
        "searchjet",
        "meilisearch",
        "site-search"
    ],
    "license": "MIT",
    "type": "library",
    "require": {
        "php": "^8.2",
        "illuminate/console": "^11.0|^12.0",
        "illuminate/database": "^11.0|^12.0",
        "illuminate/http": "^11.0|^12.0",
        "illuminate/support": "^11.0|^12.0",
        "guzzlehttp/guzzle": "^7.8"
    },
    "require-dev": {
        "laravel/pint": "^1.0",
        "orchestra/testbench": "^9.0|^10.0",
        "phpunit/phpunit": "^10.5|^11.0"
    },
    "autoload": {
        "psr-4": {
            "SearchJet\\Laravel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SearchJet\\Laravel\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "SearchJet\\Laravel\\SearchJetServiceProvider"
            ],
            "aliases": {
                "SearchJet": "SearchJet\\Laravel\\Facades\\SearchJet"
            }
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "homepage": "https://github.com/maidulcu/laravel-searchjetengine",
    "authors": [
        {
            "name": "SearchJet",
            "homepage": "https://searchjetengine.com"
        }
    ],
    "support": {
        "issues": "https://github.com/maidulcu/laravel-searchjetengine/issues",
        "source": "https://github.com/maidulcu/laravel-searchjetengine",
        "docs": "https://github.com/maidulcu/laravel-searchjetengine#readme"
    }
}
