{
    "name": "searchjet/laravel-searchjet",
    "description": "Laravel package for easy SearchJet integration - AI-powered search made simple",
    "keywords": ["laravel", "search", "meilisearch", "ai", "searchjet", "search-as-a-service"],
    "license": "MIT",
    "type": "library",
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0|^12.0",
        "illuminate/http": "^11.0|^12.0",
        "illuminate/database": "^11.0|^12.0",
        "illuminate/console": "^11.0|^12.0",
        "guzzlehttp/guzzle": "^7.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0",
        "phpunit/phpunit": "^10.0",
        "laravel/pint": "^1.0",
        "mockery/mockery": "^1.4"
    },
    "autoload": {
        "psr-4": {
            "SearchJet\\Laravel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SearchJet\\Laravel\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "SearchJet\\Laravel\\SearchJetServiceProvider"
            ],
            "aliases": {
                "SearchJet": "SearchJet\\Laravel\\Facades\\SearchJet"
            }
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "test-coverage": "vendor/bin/phpunit --coverage-html coverage",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
